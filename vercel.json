{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/projects.html", "destination": "/projets", "permanent": true },
    { "source": "/tracelot.html", "destination": "/projets/tracelot", "permanent": true },
    { "source": "/naturalink.html", "destination": "/projets/naturalink", "permanent": true },
    { "source": "/fees.html", "destination": "/projets/fees", "permanent": true },
    { "source": "/catreps.html", "destination": "/projets/catreps", "permanent": true },
    { "source": "/managex.html", "destination": "/projets/managex", "permanent": true },
    { "source": "/edusave.html", "destination": "/projets/edusave", "permanent": true },
    { "source": "/cabinet-jehovah-rapha.html", "destination": "/projets/cabinet-jehovah-rapha", "permanent": true },
    { "source": "/jms-afrique.html", "destination": "/projets/jms-afrique", "permanent": true },
    { "source": "/jecpssm.html", "destination": "/projets/jecpssm", "permanent": true },
    { "source": "/lystore.html", "destination": "/projets", "permanent": true },
    { "source": "/garaf.html", "destination": "/projets", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
